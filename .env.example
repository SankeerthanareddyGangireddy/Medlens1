# Database (PostgreSQL)
DATABASE_URL="postgresql://medlens:medlens@localhost:5432/medlens?schema=public"

# Auth
SESSION_SECRET="replace-with-a-long-random-secret"
DEMO_MODE="true"

# AI provider: mock | openai
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# OCR provider: mock | local
OCR_PROVIDER="local"

# File storage: local | s3 (s3 adapter is a future extension)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Optional S3-compatible placeholders
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# App
NEXT_PUBLIC_APP_NAME="MedLens"
MAX_UPLOAD_BYTES="10485760"
